{
  "name": "shader-demo-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run exhibits:build && pnpm run build:shell",
    "build:shell": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:visual": "node scripts/visual-smoke.mjs",
    "qa:exhibits": "node scripts/exhibit-smoke.mjs",
    "qa:water": "node scripts/water-qa.mjs",
    "qa:glass": "node scripts/glass-optics-qa-runner.mjs",
    "qa:ninth-tide": "node scripts/ninth-tide-capture.mjs",
    "qa:ninth-tide-near-black": "node scripts/ninth-tide-near-black.mjs",
    "qa:ninth-tide-quality": "node scripts/ninth-tide-quality.mjs",
    "qa:ninth-tide-cycle": "node scripts/ninth-tide-cycle.mjs",
    "qa:ninth-tide-hit-target": "node scripts/ninth-tide-hit-target.mjs",
    "qa:ninth-tide-dither": "node scripts/ninth-tide-dither.mjs",
    "qa:ninth-tide-dither-performance": "node scripts/ninth-tide-dither-performance.mjs",
    "qa:ninth-tide-pulses": "node scripts/ninth-tide-pulse-history.mjs",
    "qa:orb": "node scripts/orb-deterministic-capture.mjs",
    "qa:orb-profile": "node scripts/orb-profile.mjs",
    "qa:orb-report": "node scripts/orb-profile-report.mjs",
    "qa:motion": "node scripts/motion-qa.mjs",
    "qa:renderer": "node scripts/renderer-lifecycle.mjs",
    "qa:telemetry-reference": "node scripts/telemetry-reference.mjs",
    "qa:software-pairs": "node scripts/software-paired-cadence.mjs",
    "exhibits:build": "node scripts/build-exhibits.mjs",
    "exhibits:check": "pnpm run exhibits:build && node scripts/check-exhibit-sync.mjs",
    "lint": "eslint . && pnpm lint:tokens",
    "lint:tokens": "node scripts/token-lint.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.17.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "apca-w3": "0.1.9",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "playwright": "1.60.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2"
}
